<footer class="bg-ink-950 text-ink-300">
  <div class="container py-14 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
      <div class="lg:col-span-4">
        <div class="mb-4">
          <%- include('logo') %>
        </div>
        <p class="text-sm leading-relaxed text-ink-400 max-w-sm">
          Trusted passenger fleet rental &amp; tour operator in Bengaluru since 2011. Providing verified commercial chauffeurs, All India Tourist Permits, and transparent per-km billing.
        </p>
        <div class="flex items-center gap-2.5 mt-5">
          <% 
            const activeSocials = [
              ["instagram", business.social.instagram],
              ["tripadvisor", business.social.tripadvisor],
              ["facebook", business.social.facebook],
              ["youtube", business.social.youtube],
              ["twitter", business.social.twitter]
            ].filter(function(s) { return s[1] && s[1].trim() !== ""; });
          %>
          <% activeSocials.forEach(function(s) { %>
            <a
              href="<%= s[1] %>"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-9 h-9 rounded-lg bg-white/5 text-ink-300 hover:bg-brand-600 hover:text-white transition-colors"
              aria-label="<%= s[0] %>"
              title="<%= s[0].charAt(0).toUpperCase() + s[0].slice(1) %>"
            >
              <%- include('icon', { name: s[0], cls: 'w-4 h-4' }) %>
            </a>
          <% }); %>
          <% if (business.googleBusinessProfile) { %>
            <a
              href="<%= business.googleBusinessProfile %>"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-9 h-9 rounded-lg bg-white/5 text-sun-400 hover:bg-brand-600 hover:text-white transition-colors"
              aria-label="Verified Google Business Profile"
              title="Verified on Google (4.9★ from 210+ Google Reviews)"
            >
              <%- include('icon', { name: 'star', cls: 'w-4 h-4' }) %>
            </a>
          <% } %>
        </div>
      </div>

      <nav class="lg:col-span-2" aria-label="Company">
        <h3 class="font-display font-semibold text-white text-sm tracking-wide uppercase mb-4">Company</h3>
        <ul class="space-y-2.5 text-sm">
          <% footerCompanyLinks.forEach(function(l) { %>
            <li><a href="<%= l.href %>" title="<%= l.label %>" class="hover:text-white transition-colors"><%= l.label %></a></li>
          <% }); %>
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label="Fleet & Rentals">
        <h3 class="font-display font-semibold text-white text-sm tracking-wide uppercase mb-4">Fleet &amp; Rentals</h3>
        <ul class="space-y-2.5 text-sm">
          <% footerServiceLinks.forEach(function(l) { %>
            <li><a href="<%= l.href %>" title="<%= l.label %>" class="hover:text-white transition-colors"><%= l.label %></a></li>
          <% }); %>
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label="Tours & Routes">
        <h3 class="font-display font-semibold text-white text-sm tracking-wide uppercase mb-4">Tours &amp; Routes</h3>
        <ul class="space-y-2.5 text-sm">
          <% footerToursLinks.forEach(function(l) { %>
            <li><a href="<%= l.href %>" title="<%= l.label %>" class="hover:text-white transition-colors"><%= l.label %></a></li>
          <% }); %>
        </ul>
      </nav>

      <section class="lg:col-span-2" aria-labelledby="footer-contact-heading">
        <h3 id="footer-contact-heading" class="font-display font-semibold text-white text-sm tracking-wide uppercase mb-4">Contact</h3>
        <ul class="space-y-3 text-sm min-w-0">
          <li class="min-w-0"><a href="<%= telHref %>" title="Call Yogi Tours & Travels" class="flex items-start gap-2.5 min-w-0 hover:text-white transition-colors"><%- include('icon', { name: 'phone', cls: 'w-4 h-4 mt-0.5 shrink-0 text-brand-400' }) %><span class="min-w-0 break-words"><%= business.phone %></span></a></li>
          <li class="min-w-0"><a href="https://wa.me/<%= whatsappDigits %>" target="_blank" rel="noopener noreferrer" title="Chat on WhatsApp" class="flex items-start gap-2.5 min-w-0 hover:text-white transition-colors"><%- include('icon', { name: 'whatsapp', cls: 'w-4 h-4 mt-0.5 shrink-0 text-brand-400' }) %><span class="min-w-0 break-words"><%= business.whatsapp %></span></a></li>
          <li class="min-w-0"><a href="<%= mailtoHref %>" title="Email Yogi Tours & Travels" class="flex items-start gap-2.5 min-w-0 hover:text-white transition-colors"><%- include('icon', { name: 'mail', cls: 'w-4 h-4 mt-0.5 shrink-0 text-brand-400' }) %><span class="min-w-0 break-all"><%= business.email %></span></a></li>
          <li class="flex items-start gap-2.5 min-w-0">
            <%- include('icon', { name: 'map-pin', cls: 'w-4 h-4 mt-0.5 shrink-0 text-brand-400' }) %>
            <span class="min-w-0 break-words">
              <%= business.addressLine %>
              <a href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(business.addressLine) %>" target="_blank" rel="noopener noreferrer" title="Get Directions to Yogi Tours & Travels Office on Google Maps" class="block text-brand-400 hover:text-brand-300 transition-colors mt-1">Get Directions</a>
            </span>
          </li>
        </ul>
      </section>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-ink-500">
      <p>&copy; <%= new Date().getFullYear() %> <%= business.name %>. All rights reserved.</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1.5">
        <% legalLinks.forEach(function(l) { %>
          <li><a href="<%= l.href %>" title="<%= l.label %>" class="hover:text-ink-200 transition-colors"><%= l.label %></a></li>
        <% }); %>
        <li><button type="button" data-cookie-settings class="hover:text-ink-200 transition-colors">Cookie preferences</button></li>
      </ul>
    </div>
  </div>
</footer>
