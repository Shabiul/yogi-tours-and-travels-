<%- include('../partials/page-start') %>
<%- include('../partials/breadcrumbs') %>

<section class="py-10 lg:py-14 bg-gradient-to-b from-brand-50/50 via-white to-white">
  <div class="container">
    <div class="max-w-3xl">
      <span class="badge badge-accent text-xs font-semibold tracking-wide uppercase mb-3">
        <%- include('../partials/icon', { name: 'route', cls: 'w-3.5 h-3.5' }) %>
        Doorstep Pickup &bull; Verified Outstation Chauffeurs
      </span>
      <h1 class="font-display font-bold text-3xl sm:text-4xl text-ink-900 tracking-tight">
        <% if (activeVehicle) { %>
          <%= activeVehicle.name %> Rental from Bangalore
        <% } else { %>
          Outstation Vehicle Rentals from Bangalore
        <% } %>
      </h1>
      <p class="text-base sm:text-lg text-ink-600 mt-4 leading-relaxed">
        <% if (activeVehicle) { %>
          Book a verified, chauffeur-driven <strong><%= activeVehicle.name %></strong> for outstation getaways, weekend trips, and family tours from Bangalore. Starting from ₹<%= activeVehicle.ratePerKm || 18 %>/km with zero hidden charges.
        <% } else { %>
          Choose from over 15 sanitized vehicles — compact sedans, premium Toyota Crysta/Hycross, Force Urbania luxury vans, Maharaja Tempo Travellers, and AC tourist coaches. Confirmed doorstep pickup across every Bangalore locality.
        <% } %>
      </p>
    </div>

    <!-- Vehicle Selector Pills -->
    <div class="mt-8 pt-6 border-t border-ink-200/80">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-bold text-ink-500 uppercase tracking-wider">Filter by Vehicle:</span>
        <a href="/rent" title="View all rental vehicles" class="text-xs text-brand-700 hover:text-brand-800 font-medium">Reset All Vehicles</a>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href="/rent"
          title="All vehicles"
          class="badge <%= !activeVehicle ? 'badge-accent !py-2 !px-3.5' : 'badge-outline !py-2 !px-3.5 hover:border-brand-300' %> text-xs font-medium"
        >
          All Fleet
        </a>
        <% vehicles.forEach(function(veh) { %>
        <a
          href="/rent/<%= veh.slug %>"
          title="Rent <%= veh.name %> from Bangalore"
          class="badge <%= activeVehicle && activeVehicle.slug === veh.slug ? 'badge-accent !py-2 !px-3.5' : 'badge-outline !py-2 !px-3.5 hover:border-brand-300' %> text-xs font-medium"
        >
          <%= veh.name %>
        </a>
        <% }); %>
      </div>
    </div>
  </div>
</section>

<!-- Featured Outstation Routes Grid -->
<section class="py-12 bg-white">
  <div class="container">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-ink-900 tracking-tight">
          <% if (activeVehicle) { %>
            Popular Routes for <%= activeVehicle.name %>
          <% } else { %>
            Popular Bangalore Outstation Trips
          <% } %>
        </h2>
        <p class="text-sm text-ink-500 mt-1">Verified distance, estimated drive times, and transparent per-km rates.</p>
      </div>
      <span class="text-xs font-semibold text-brand-700 bg-brand-50 py-1.5 px-3 rounded-full border border-brand-100 self-start sm:self-auto">
        Showing <%= featuredRoutes.length %> Handpicked Routes
      </span>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% featuredRoutes.forEach(function(route) { %>
      <%
        const rPhoto = route.vehicle.imageKey || "/assets/images/destinations/hero-bangalore.webp";
        const rTitle = `Book ${route.vehicle.name} from ${route.origin.name} to ${route.destination.name}`;
      %>
      <div class="rounded-2xl border border-ink-200/90 bg-white overflow-hidden shadow-xs hover:shadow-md hover:border-brand-300 transition-all flex flex-col group">
        <!-- Card Image with Anchor + Title + Alt -->
        <a
          href="<%= route.canonicalPath %>"
          title="<%= rTitle %>"
          class="block aspect-[16/10] overflow-hidden relative bg-ink-100"
        >
          <img
            src="<%= rPhoto %>"
            alt="<%= route.vehicle.name %> rental from <%= route.origin.name %> to <%= route.destination.name %>"
            title="<%= rTitle %>"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/70 via-transparent to-transparent flex items-end p-4">
            <span class="text-white text-xs font-semibold drop-shadow"><%= route.vehicle.name %></span>
          </div>
          <span class="absolute top-3 right-3 bg-white/95 backdrop-blur-xs text-ink-900 font-bold text-xs py-0.5 px-2.5 rounded-full shadow-2xs">
            ~<%= route.distanceKm %> km
          </span>
        </a>

        <!-- Card Body -->
        <div class="p-5 flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-1.5 text-xs text-brand-700 font-semibold mb-1">
              <%- include('../partials/icon', { name: 'map-pin', cls: 'w-3.5 h-3.5' }) %>
              <span><%= route.origin.name %> &rarr; <%= route.destination.name %></span>
            </div>
            <h3 class="font-display font-bold text-base text-ink-900 group-hover:text-brand-700 transition-colors">
              <a href="<%= route.canonicalPath %>" title="<%= rTitle %>">
                <%= route.vehicle.name %> to <%= route.destination.name %>
              </a>
            </h3>
            <p class="text-xs text-ink-500 mt-2 line-clamp-2 leading-relaxed">
              <%= route.uniqueRouteHook %>
            </p>
          </div>

          <div class="mt-5 pt-4 border-t border-ink-100 flex items-center justify-between text-xs">
            <div>
              <span class="text-ink-400">Est. Round-Trip:</span>
              <p class="font-display font-bold text-sm text-ink-900 mt-0.5">₹<%= route.estimatedFare.toLocaleString('en-IN') %></p>
            </div>
            <a
              href="<%= route.canonicalPath %>"
              title="<%= rTitle %>"
              class="btn btn-outline !py-1.5 !px-3.5 text-xs font-medium group-hover:bg-brand-600 group-hover:text-white group-hover:border-brand-600 transition-colors"
            >
              <span>View Route</span>
              <%- include('../partials/icon', { name: 'arrow-right', cls: 'w-3.5 h-3.5' }) %>
            </a>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Bangalore Localities Coverage Directory -->
<section class="py-12 bg-ink-50/70 border-t border-ink-200/60">
  <div class="container">
    <div class="max-w-2xl mb-8">
      <h2 class="font-display font-bold text-2xl text-ink-900 tracking-tight">
        Doorstep Pickup Localities Across Bangalore
      </h2>
      <p class="text-sm text-ink-500 mt-1">
        Our verified outstation chauffeurs pick you up right from your apartment gate or hotel porch.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
      <% origins.forEach(function(orig) { %>
      <div class="p-4 rounded-xl bg-white border border-ink-200/80 shadow-2xs">
        <div class="flex items-center gap-2 text-ink-900 font-semibold text-sm">
          <%- include('../partials/icon', { name: 'map-pin', cls: 'w-4 h-4 text-brand-600 flex-shrink-0' }) %>
          <span><%= orig.name %></span>
        </div>
        <p class="text-[11px] text-ink-500 mt-1.5 line-clamp-2"><%= orig.pickupNote %></p>
        <span class="inline-block mt-2 text-[10px] text-brand-700 font-medium bg-brand-50 px-2 py-0.5 rounded">
          <%= orig.zone %>
        </span>
      </div>
      <% }); %>
    </div>
  </div>
</section>

