<%- include('../partials/page-start') %>
<%- include('../partials/breadcrumbs') %>

<%
  const photo = post.vehicle.imageKey || "/assets/images/destinations/hero-bangalore.webp";
  const photoAlt = `${post.vehicle.name} from ${post.origin.name} to ${post.destination.name} fare breakdown`;
  const photoTitle = `View ${post.vehicle.name} rental pricing for ${post.origin.name} to ${post.destination.name}`;
%>

<article class="py-10 lg:py-16">
  <div class="container grid lg:grid-cols-5 gap-8 lg:gap-12">
    <div class="lg:col-span-3">
      <!-- Article Header -->
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="badge badge-accent text-xs font-semibold tracking-wide uppercase">
          <%- include('../partials/icon', { name: 'wallet', cls: 'w-3.5 h-3.5' }) %>
          2026 Cost &amp; Fare Guide
        </span>
        <span class="badge badge-outline text-xs">
          <%- include('../partials/icon', { name: 'route', cls: 'w-3.5 h-3.5' }) %>
          ~<%= post.distanceKm %> km One-Way
        </span>
      </div>

      <h1 class="font-display font-bold text-3xl sm:text-4xl text-ink-900 tracking-tight leading-tight">
        <%= post.h1 %>
      </h1>

      <p class="text-sm text-ink-500 mt-2">
        Published by <strong>Yogi Tours Research Desk</strong> &bull; Verified Outstation Commercial Tariff
      </p>

      <!-- AI OVERVIEWS DIRECT ANSWER BLOCK (Google AIO Optimized) -->
      <div id="ai-overview-answer" class="mt-6 rounded-2xl bg-gradient-to-br from-brand-50/80 via-white to-brand-50/40 border-2 border-brand-200/90 p-5 sm:p-6 shadow-xs relative">
        <div class="flex items-center gap-2 text-xs font-bold text-brand-800 uppercase tracking-wider mb-2">
          <%- include('../partials/icon', { name: 'badge-check', cls: 'w-4 h-4 text-brand-600' }) %>
          <span>Direct Answer / Quick Cost Summary</span>
        </div>
        <p class="text-ink-900 font-semibold text-base sm:text-[17px] leading-relaxed">
          <%= post.directAnswerAio %>
        </p>
      </div>

      <!-- Vehicle Photo with Anchor + Title + Alt -->
      <div class="mt-8 rounded-2xl overflow-hidden border border-ink-200 bg-ink-900 relative group aspect-[16/9]">
        <a
          href="<%= photo %>"
          target="_blank"
          rel="noopener"
          title="<%= photoTitle %>"
          class="block w-full h-full"
        >
          <img
            src="<%= photo %>"
            alt="<%= photoAlt %>"
            title="<%= photoTitle %>"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/70 via-transparent to-transparent flex items-end p-4">
            <span class="text-white text-xs font-semibold drop-shadow"><%= post.vehicle.name %> &bull; <%= post.vehicle.seats %> Seats</span>
          </div>
        </a>
      </div>

      <!-- DYNAMIC DATA TABLE (Essential for AIO & Snippet Rankings) -->
      <div class="mt-8">
        <h2 class="font-display font-bold text-2xl text-ink-900 mb-3">
          Itemized Trip Cost Breakdown
        </h2>
        <p class="text-sm text-ink-600 mb-4">
          Calculated for a standard <%= post.durationDays %>-day round trip departing from <%= post.origin.name %> to <%= post.destination.name %> and back.
        </p>

        <div class="overflow-x-auto rounded-xl border border-ink-200 shadow-2xs">
          <table class="w-full text-left text-sm text-ink-800">
            <thead class="bg-ink-50 text-ink-900 font-semibold text-xs uppercase tracking-wider border-b border-ink-200">
              <tr>
                <th class="py-3 px-4">Cost Parameter</th>
                <th class="py-3 px-4">Rate / Calculation</th>
                <th class="py-3 px-4 text-right">Subtotal</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink-100">
              <tr>
                <td class="py-3 px-4 font-medium">Round-Trip Distance</td>
                <td class="py-3 px-4"><%= post.distanceKm %> km &times; 2 = ~<%= post.roundTripKm %> km</td>
                <td class="py-3 px-4 text-right font-medium">--</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-medium">Base Vehicle Rate</td>
                <td class="py-3 px-4">₹<%= post.vehicle.ratePerKm %>/km (Full AC)</td>
                <td class="py-3 px-4 text-right font-semibold text-ink-900">₹<%= post.baseFare.toLocaleString('en-IN') %></td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-medium">Chauffeur Bata / Allowance</td>
                <td class="py-3 px-4"><%= post.durationDays %> Day(s) allowance</td>
                <td class="py-3 px-4 text-right font-semibold text-ink-900">₹<%= post.driverBata.toLocaleString('en-IN') %></td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-medium">Estimated Highway Tolls</td>
                <td class="py-3 px-4">Via <%= post.destination.highway %></td>
                <td class="py-3 px-4 text-right font-semibold text-ink-900">₹<%= post.tollEstimate.toLocaleString('en-IN') %></td>
              </tr>
              <% if (post.statePermitEstimate > 0) { %>
              <tr>
                <td class="py-3 px-4 font-medium">Interstate Permit Tax</td>
                <td class="py-3 px-4">Karnataka to <%= post.destination.state %> border permit</td>
                <td class="py-3 px-4 text-right font-semibold text-ink-900">₹<%= post.statePermitEstimate.toLocaleString('en-IN') %></td>
              </tr>
              <% } %>
              <tr class="bg-brand-50/60 text-brand-900 font-bold border-t-2 border-brand-200">
                <td class="py-3.5 px-4 text-base">Total Estimated Outstation Cost</td>
                <td class="py-3.5 px-4 text-xs font-normal text-brand-700">All-Inclusive (Tolls, Driver Bata, Fuel)</td>
                <td class="py-3.5 px-4 text-right text-lg text-brand-900 font-display">₹<%= post.totalCost.toLocaleString('en-IN') %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Why Choose This Vehicle for This Route -->
      <div class="mt-10 rounded-2xl bg-white border border-ink-200 p-6 sm:p-7 shadow-xs">
        <h2 class="font-display font-bold text-xl text-ink-900 mb-3">
          Why Choose the <%= post.vehicle.name %> for the <%= post.destination.name %> Route?
        </h2>
        <p class="text-[15px] text-ink-700 leading-relaxed">
          <%= post.uniqueRouteHook %>
        </p>
        <div class="mt-4 grid sm:grid-cols-2 gap-3 text-xs text-ink-600 pt-4 border-t border-ink-100">
          <div class="flex items-center gap-2">
            <%- include('../partials/icon', { name: 'check', cls: 'w-4 h-4 text-emerald-600' }) %>
            <span><strong>Seating:</strong> <%= post.vehicle.seats %> Pushback Reclining Seats</span>
          </div>
          <div class="flex items-center gap-2">
            <%- include('../partials/icon', { name: 'check', cls: 'w-4 h-4 text-emerald-600' }) %>
            <span><strong>Luggage:</strong> <%= post.vehicle.luggage %></span>
          </div>
        </div>
      </div>

      <!-- En-Route Stops & Itinerary -->
      <div class="mt-10">
        <h2 class="font-display font-bold text-2xl text-ink-900 mb-4">
          Recommended En-Route Stops: <%= post.origin.name %> to <%= post.destination.name %>
        </h2>
        <div class="space-y-3.5">
          <% post.enRouteStops.forEach(function(stop, idx) { %>
          <div class="p-4 rounded-xl border border-ink-200 bg-white shadow-2xs flex items-start gap-3.5">
            <span class="w-7 h-7 rounded-full bg-brand-100 text-brand-800 font-bold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">
              <%= idx + 1 %>
            </span>
            <div>
              <p class="font-semibold text-ink-900 text-sm"><%= stop.name %> <span class="text-xs font-normal text-brand-700 bg-brand-50 px-2 py-0.5 rounded ml-1"><%= stop.type %></span></p>
              <p class="text-xs text-ink-600 mt-1 leading-relaxed"><%= stop.description %></p>
            </div>
          </div>
          <% }); %>
        </div>
      </div>

      <!-- Frequently Asked Questions -->
      <div id="faq" class="mt-10 rounded-2xl bg-ink-50/80 border border-ink-200 p-6 sm:p-7">
        <h2 class="font-display font-bold text-xl text-ink-900 mb-4">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          <% post.faqs.forEach(function(faq) { %>
          <div class="bg-white rounded-xl border border-ink-100 p-4 shadow-2xs">
            <p class="font-semibold text-ink-900 text-sm"><%= faq.question %></p>
            <p class="text-xs text-ink-600 mt-1.5 leading-relaxed"><%= faq.answer %></p>
          </div>
          <% }); %>
        </div>
      </div>

      <!-- Money Page Link (The "Money" CTA as required by the specification) -->
      <div class="mt-10 p-6 rounded-2xl bg-gradient-to-r from-brand-900 to-ink-900 text-white shadow-md">
        <h3 class="font-display font-bold text-xl mb-2">Ready to Book Your <%= post.vehicle.name %>?</h3>
        <p class="text-sm text-white/80 mb-5 leading-relaxed">
          Lock in your preferred departure date with guaranteed vehicle availability and transparent per-km billing.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="<%= post.moneyPageUrl %>"
            title="Book <%= post.vehicle.name %> from <%= post.origin.name %> to <%= post.destination.name %>"
            class="btn btn-accent text-sm font-semibold"
          >
            <span>Book <%= post.vehicle.name %> from <%= post.origin.name %> to <%= post.destination.name %> Here</span>
            <%- include('../partials/icon', { name: 'arrow-right', cls: 'w-4 h-4' }) %>
          </a>
          <a
            href="/rent"
            title="Browse all outstation rental options"
            class="btn btn-outline text-white border-white/30 hover:bg-white/10 text-sm"
          >
            <span>Browse All Rental Routes</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-2">
      <div class="admin-card !border-ink-200 p-6 sticky top-24 shadow-md bg-white rounded-2xl">
        <p class="text-xs font-bold text-brand-700 uppercase tracking-wider">Fast Route Summary</p>
        <h3 class="font-display font-bold text-xl text-ink-900 mt-1"><%= post.destination.name %> Cab Fare</h3>

        <div class="py-4 space-y-2.5 text-xs text-ink-600 border-b border-ink-100">
          <div class="flex justify-between">
            <span>Vehicle:</span>
            <strong class="text-ink-900"><%= post.vehicle.name %></strong>
          </div>
          <div class="flex justify-between">
            <span>Seating:</span>
            <strong class="text-ink-900"><%= post.vehicle.seats %> Passengers</strong>
          </div>
          <div class="flex justify-between">
            <span>Distance:</span>
            <strong class="text-ink-900">~<%= post.distanceKm %> km (<%= post.driveTime %>)</strong>
          </div>
          <div class="flex justify-between">
            <span>Estimated Total:</span>
            <strong class="text-brand-800 text-sm font-bold">₹<%= post.totalCost.toLocaleString('en-IN') %></strong>
          </div>
        </div>

        <div class="mt-5 space-y-2.5">
          <a
            href="<%= post.moneyPageUrl %>"
            title="Instant quotation for <%= post.vehicle.name %> to <%= post.destination.name %>"
            class="btn btn-accent w-full py-3 text-sm font-semibold"
          >
            <%- include('../partials/icon', { name: 'send', cls: 'w-4 h-4' }) %>
            <span>Get Confirmed Quote</span>
          </a>
          <a
            href="https://wa.me/<%= whatsappDigits %>?text=<%= encodeURIComponent('Hi Yogi Tours, I am reading the cost guide for ' + post.vehicle.name + ' to ' + post.destination.name + '. Can you share availability and final quotation?') %>"
            target="_blank"
            rel="noopener"
            title="WhatsApp Yogi Tours reservation desk"
            class="btn btn-outline w-full py-2.5 text-xs"
          >
            <%- include('../partials/icon', { name: 'whatsapp', cls: 'w-4 h-4 text-emerald-600' }) %>
            <span>WhatsApp Enquiry</span>
          </a>
        </div>

        <div class="mt-6 pt-5 border-t border-ink-100">
          <p class="text-xs font-semibold text-ink-900 mb-2">Related Comparison Guides</p>
          <ul class="space-y-1.5 text-xs text-ink-600">
            <li>
              <a href="/blog/compare/force-urbania-vs-innova-crysta-for-<%= post.destination.slug %>" class="hover:text-brand-700 flex items-center justify-between py-1">
                <span>Force Urbania vs Innova Crysta for <%= post.destination.name %></span>
                <%- include('../partials/icon', { name: 'chevron-right', cls: 'w-3 h-3 text-ink-400' }) %>
              </a>
            </li>
            <li>
              <a href="/blog/itinerary/<%= post.origin.slug %>-to-<%= post.destination.slug %>-weekend-trip" class="hover:text-brand-700 flex items-center justify-between py-1">
                <span><%= post.origin.name %> to <%= post.destination.name %> Weekend Itinerary</span>
                <%- include('../partials/icon', { name: 'chevron-right', cls: 'w-3 h-3 text-ink-400' }) %>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</article>

<%- include('../partials/cta-section') %>
<%- include('../partials/page-end') %>
